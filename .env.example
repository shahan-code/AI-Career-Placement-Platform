# =======================================================================
# AI Career & Placement Intelligence Platform
# Environment Configuration Template
# =======================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=ai_career_placement_secret_jwt_key_2026_change_in_production

# PostgreSQL Database Configuration (Optional: connects if active, otherwise uses memory engine)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_placement_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ai_placement_db

# Real AI Model API Keys (Gemini / OpenAI)
# Leave blank to use built-in domain-specific heuristic intelligence
GEMINI_API_KEY=
AI_API_KEY=
OPENAI_API_KEY=
